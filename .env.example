# Variáveis de ambiente do LAM Marketing Hub
# Copie para .env.local em desenvolvimento ou configure no Railway em produção.

# Ambiente: "development" ou "production"
NODE_ENV=development

# Porta do servidor (Railway preenche automaticamente)
PORT=3000

# Caminho do banco SQLite (em produção, monte um Volume aqui)
# Padrão: ./data/lam.db
# DATABASE_PATH=/app/data/lam.db
